---
import { work } from '../data/work';
import '../styles/global.css';

const email = 'johnemmealesbenitez@gmail.com';
const featured = work.filter((item) => item.category === 'AI ads').slice(0, 3);
const filters = ['All work', 'AI ads', 'AI drama', 'Reels', 'Shorts'];
const person = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: 'John Benitez',
	jobTitle: 'Video editor and AI UGC creator',
	email: `mailto:${email}`,
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#f7f7f2" />
		<meta name="description" content="John Benitez is a video editor and AI UGC creator. Explore AI ads, AI drama, reels, and shorts." />
		<meta property="og:type" content="website" />
		<meta property="og:title" content="John Benitez — Video editor & AI UGC creator" />
		<meta property="og:description" content="Selected AI ads, AI drama, reels, and short-form video work by John Benitez." />
		<meta property="og:image" content="https://drive.google.com/thumbnail?id=1HZlxqd9InK5jI4YrttLNoj16ioHJ1OGn&sz=w1200" />
		<title>John Benitez — Video editor & AI UGC creator</title>
		<script type="application/ld+json" set:html={JSON.stringify(person)} />
	</head>
	<body>
		<div class="site-shell">
			<aside class="sidebar" aria-label="Site navigation">
				<a class="wordmark" href="#top" aria-label="John Benitez, home">john<span>.</span></a>
				<p class="sidebar-role">Video editor<br />&amp; AI UGC creator</p>
				<nav class="side-nav" aria-label="Main navigation">
					<a href="#work">Work</a>
					<a href="#about">About</a>
					<a href="#services">Services</a>
					<a href="#experience">Experience</a>
					<a href="#contact">Contact</a>
				</nav>
				<div class="sidebar-actions">
					<a class="button button-primary email-link" href={`mailto:${email}`}>Email me</a>
					<button class="theme-toggle" type="button" aria-label="Switch color theme" aria-pressed="false">
						<svg class="sun-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42"/></svg>
						<svg class="moon-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.8 15.4A8.8 8.8 0 0 1 8.6 3.2 8.8 8.8 0 1 0 20.8 15.4Z"/></svg>
						<span class="theme-label">Use light theme</span>
					</button>
				</div>
				<p class="sidebar-note">Independent video editor<br />Available for new projects</p>
			</aside>

			<main id="top">
				<header class="mobile-header">
					<a class="wordmark" href="#top">john<span>.</span></a>
					<button class="theme-toggle mobile-theme-toggle" type="button" aria-label="Switch color theme" aria-pressed="false">
						<svg class="sun-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42"/></svg>
						<svg class="moon-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.8 15.4A8.8 8.8 0 0 1 8.6 3.2 8.8 8.8 0 1 0 20.8 15.4Z"/></svg>
						<span class="theme-label">Use light theme</span>
					</button>
				</header>

				<section class="intro section-block" aria-labelledby="intro-title">
					<p class="eyebrow"><span class="status-dot"></span> Video editor · AI UGC creator</p>
					<div class="intro-copy">
						<p class="overline">John Benitez</p>
						<h1 id="intro-title">Stories made<br />to <em>move.</em></h1>
						<p class="intro-description">Video editing and AI-generated content for ads, drama, reels, and shorts.</p>
						<div class="intro-actions">
							<a class="button button-primary" href="#work">Explore selected work <span aria-hidden="true">↓</span></a>
							<a class="text-link" href={`mailto:${email}`}>Get in touch <span aria-hidden="true">↗</span></a>
						</div>
					</div>
					<button class="showreel media-open" type="button" data-work-id={featured[0]?.title} aria-label="Open selected work: Capsule">
						<img src={`https://drive.google.com/thumbnail?id=${featured[0]?.url.match(/\/d\/([^/]+)/)?.[1]}&sz=w1000`} alt="" loading="eager" />
						<span class="showreel-play" aria-hidden="true"><span></span></span>
						<span class="showreel-caption"><span>Selected work</span><strong>Watch a featured AI ad</strong></span>
					</button>
				</section>

				<div class="quiet-line"><span>Thoughtful edits. Clear stories.</span><span>AI work is labeled throughout</span></div>

				<section class="section-block featured-section" aria-labelledby="featured-title">
					<div class="section-heading">
						<div><p class="overline">Selected work</p><h2 id="featured-title">Featured <em>AI ads.</em></h2></div>
						<a class="text-link" href="#work">View all work <span aria-hidden="true">↓</span></a>
					</div>
					<div class="featured-grid">
						{featured.map((item) => {
							const id = item.url.match(/\/d\/([^/]+)/)?.[1];
							return <article class="featured-item">
								<button class="media-card media-open" type="button" data-work-id={item.title} aria-label={`Open ${item.title}`}>
									<img src={item.poster ?? `https://drive.google.com/thumbnail?id=${id}&sz=w800`} alt={`${item.title}, AI ad`} loading="lazy" />
									<span class="play-mark" aria-hidden="true"><span></span></span>
								</button>
								<div class="item-meta"><div><span class="item-category">AI ad</span><h3>{item.title}</h3></div><span class="item-index">Featured</span></div>
								<a class="small-link" href={`mailto:${email}?subject=${encodeURIComponent(`Video inquiry: ${item.title}`)}&body=${encodeURIComponent('Platform:\nLength:\nDeadline:\nBudget:')}`}>Email about this</a>
							</article>;
						})}
					</div>
				</section>

				<section class="section-block work-section" id="work" aria-labelledby="work-title">
					<div class="section-heading">
						<div><p class="overline">Browse by format</p><h2 id="work-title">Selected <em>work.</em></h2></div>
						<span class="work-count">{work.length} projects</span>
					</div>
					<div class="filter-list" role="group" aria-label="Filter work by category">
						{filters.map((filter, index) => <button class:list={['filter-button', { active: index === 0 }]} type="button" data-filter={filter} aria-pressed={index === 0 ? 'true' : 'false'}>{filter}</button>)}
					</div>
					<div class="work-grid" aria-live="polite">
						{work.map((item) => {
							const id = item.url.match(/\/d\/([^/]+)/)?.[1];
							return <article class="work-item" data-category={item.category}>
								<button class="media-card media-open" type="button" data-work-id={item.title} aria-label={`Open ${item.title}`}>
									<img src={item.poster ?? `https://drive.google.com/thumbnail?id=${id}&sz=w800`} alt={`${item.title}, ${item.category === 'AI ads' || item.category === 'AI drama' ? 'AI-generated ' : ''}${item.category.toLowerCase()} video`} loading="lazy" />
									{item.clip && <video class="preview-video" src={item.clip} poster={item.poster} muted loop playsinline preload="none" aria-hidden="true"></video>}
									<span class="play-mark" aria-hidden="true"><span></span></span>
								</button>
								<div class="item-meta"><div><span class="item-category">{item.category}</span><h3>{item.title}</h3></div><span class="item-index">{String(work.indexOf(item) + 1).padStart(2, '0')}</span></div>
								<div class="item-actions"><a class="small-link" href={`mailto:${email}?subject=${encodeURIComponent(`Video inquiry: ${item.title}`)}&body=${encodeURIComponent('Platform:\nLength:\nDeadline:\nBudget:')}`}>Email about this</a><a class="small-link drive-link" href={item.url} target="_blank" rel="noreferrer">Open video ↗</a></div>
							</article>;
						})}
					</div>
					<p class="empty-state" hidden>No work in this category yet.</p>
				</section>

				<section class="section-block split-section" id="about" aria-labelledby="about-title">
					<div class="split-title"><p class="overline">A little about me</p><h2 id="about-title">A story is<br /><em>in the details.</em></h2></div>
					<div class="split-copy"><p>I’m John Benitez, a video editor and AI UGC creator. My selected work spans AI ads, AI drama, reels, and shorts.</p><p>I care about making each piece easy to follow, giving the important moments room to land, and keeping the edit focused on the story.</p><a class="text-link" href={`mailto:${email}`}>Tell me about your project <span aria-hidden="true">↗</span></a></div>
				</section>

				<section class="section-block" id="services" aria-labelledby="services-title">
					<div class="section-heading"><div><p class="overline">Ways to work together</p><h2 id="services-title">Editing for <em>every format.</em></h2></div></div>
					<div class="service-list">
						<div class="service-row"><span>01</span><h3>AI ads</h3><p>AI-generated advertising work, edited for a clear, focused message.</p><span class="service-type">AI</span></div>
						<div class="service-row"><span>02</span><h3>AI drama</h3><p>AI-generated dramatic video, shaped around its story and pacing.</p><span class="service-type">AI</span></div>
						<div class="service-row"><span>03</span><h3>Reels and shorts</h3><p>Short-form edits for vertical social video.</p><span class="service-type">Short form</span></div>
					</div>
					<p class="quote-note">Project quotes are available on request.</p>
				</section>

				<section class="section-block process-section" aria-labelledby="process-title">
					<div class="section-heading"><div><p class="overline">From brief to final cut</p><h2 id="process-title">A simple <em>process.</em></h2></div></div>
					<ol class="process-list"><li><span>01</span><div><h3>Share the brief</h3><p>Tell me about the platform, length, deadline, and budget.</p></div></li><li><span>02</span><div><h3>Align on the edit</h3><p>We agree on the direction and what the finished video needs to do.</p></div></li><li><span>03</span><div><h3>Review the cut</h3><p>We review the edit together and settle any final changes.</p></div></li><li><span>04</span><div><h3>Deliver</h3><p>The finished video is prepared for the format we agreed on.</p></div></li></ol>
				</section>

				<section class="section-block split-section compact-section" id="experience" aria-labelledby="experience-title">
					<div class="split-title"><p class="overline">Background</p><h2 id="experience-title">Experience &amp;<br /><em>certifications.</em></h2></div>
					<div class="split-copy"><p>For information about my experience and certifications, get in touch by email.</p><a class="text-link" href={`mailto:${email}`}>Ask about my background <span aria-hidden="true">↗</span></a></div>
				</section>

				<section class="section-block faq-section" aria-labelledby="faq-title">
					<div class="section-heading"><div><p class="overline">A few quick answers</p><h2 id="faq-title">Good to <em>know.</em></h2></div></div>
					<details><summary>Which kinds of video do you work on?</summary><p>Selected work includes AI ads, AI drama, reels, and shorts.</p></details>
					<details><summary>How do I ask about a project?</summary><p>Send an email with the platform, video length, deadline, and budget. You can use the inquiry link on any work sample to start a draft.</p></details>
					<details><summary>How are AI-generated projects identified?</summary><p>AI ads and AI drama are labeled as AI in the work list and throughout the portfolio.</p></details>
					<details><summary>How much does a project cost?</summary><p>Quotes are available on request. Share a short brief to get started.</p></details>
				</section>

				<section class="contact-panel" id="contact" aria-labelledby="contact-title">
					<div class="contact-kicker"><span class="overline">Have something in mind?</span><span><span class="status-dot"></span> Open for project inquiries</span></div>
					<h2 id="contact-title">Let’s make<br />something <em>memorable.</em></h2>
					<div class="contact-bottom"><p>Tell me a little about what you’re making.<br />I’ll get back to you by email.</p><div class="contact-actions"><a class="button button-primary email-link" href={`mailto:${email}`}>Email me <span aria-hidden="true">↗</span></a><button class="copy-email" type="button" data-email={email}>Copy email</button><span class="copy-feedback" aria-live="polite"></span></div></div>
				</section>
				<footer><a class="wordmark footer-mark" href="#top">john<span>.</span></a><span>John Benitez · Video editor and AI UGC creator</span><a href="#top">Back to top ↑</a></footer>
			</main>
		</div>
		<a class="mobile-hire" href={`mailto:${email}`}>Hire me <span aria-hidden="true">↗</span></a>
		<dialog class="video-dialog" aria-label="Video preview"><form method="dialog"><button class="dialog-close" aria-label="Close video preview">Close <span aria-hidden="true">×</span></button></form><div class="dialog-content"></div></dialog>

		<script>
			import { work as workItems } from '../data/work';
			const root = document.documentElement;
			const themeButtons = [...document.querySelectorAll<HTMLButtonElement>('.theme-toggle')];
			const reflectTheme = (theme: 'light' | 'dark') => {
				themeButtons.forEach((button) => {
					button.setAttribute('aria-pressed', String(theme === 'light'));
					button.querySelector('.theme-label')!.textContent = theme === 'dark' ? 'Use light theme' : 'Use dark theme';
					button.setAttribute('aria-label', theme === 'dark' ? 'Switch to light theme' : 'Switch to dark theme');
				});
			};
			const setTheme = (theme: 'light' | 'dark') => {
				root.dataset.theme = theme;
				localStorage.setItem('portfolio-theme', theme);
				reflectTheme(theme);
			};
			const storedTheme = localStorage.getItem('portfolio-theme');
			if (storedTheme === 'light' || storedTheme === 'dark') setTheme(storedTheme);
			else reflectTheme(window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
			themeButtons.forEach((button) => button.addEventListener('click', () => setTheme(root.dataset.theme === 'dark' ? 'light' : 'dark')));

			const filters = [...document.querySelectorAll<HTMLButtonElement>('.filter-button')];
			const workCards = [...document.querySelectorAll<HTMLElement>('.work-item')];
			const emptyState = document.querySelector<HTMLElement>('.empty-state')!;
			filters.forEach((button) => button.addEventListener('click', () => {
				filters.forEach((filter) => { filter.classList.remove('active'); filter.setAttribute('aria-pressed', 'false'); });
				button.classList.add('active'); button.setAttribute('aria-pressed', 'true');
				let shown = 0;
				workCards.forEach((card) => {
					const visible = button.dataset.filter === 'All work' || card.dataset.category === button.dataset.filter;
					card.hidden = !visible;
					if (visible) shown++;
				});
				emptyState.hidden = shown > 0;
			}));

			const dialog = document.querySelector<HTMLDialogElement>('.video-dialog')!;
			const dialogContent = dialog.querySelector<HTMLElement>('.dialog-content')!;
			document.querySelectorAll<HTMLButtonElement>('.media-open').forEach((button) => button.addEventListener('click', () => {
				const item = workItems.find((entry) => entry.title === button.dataset.workId);
				if (!item) return;
				const fileId = item.url.match(/\/d\/([^/]+)/)?.[1];
				const poster = item.poster ?? (fileId ? `https://drive.google.com/thumbnail?id=${fileId}&sz=w1200` : '');
				const encodedTitle = item.title.replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;');
				if (item.youtubeId) {
					dialogContent.innerHTML = `<div class="youtube-facade"><img src="https://i.ytimg.com/vi/${item.youtubeId}/hqdefault.jpg" alt=""><button type="button" class="facade-play" aria-label="Play ${encodedTitle}"><span></span></button></div><h2>${encodedTitle}</h2>`;
					dialogContent.querySelector('.facade-play')?.addEventListener('click', () => {
						dialogContent.querySelector('.youtube-facade')!.innerHTML = `<iframe src="https://www.youtube-nocookie.com/embed/${item.youtubeId}?autoplay=1" title="${encodedTitle}" allow="accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>`;
					});
				} else {
					dialogContent.innerHTML = `<div class="dialog-poster">${poster ? `<img src="${poster}" alt="">` : ''}<span class="play-mark" aria-hidden="true"><span></span></span></div><h2>${encodedTitle}</h2><p>${item.category === 'AI ads' || item.category === 'AI drama' ? 'AI · ' : ''}${item.category}</p><a class="button button-primary" href="${item.url}" target="_blank" rel="noreferrer">Watch video on Google Drive ↗</a>`;
				}
				dialog.showModal();
			}));
			dialog.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); });
			dialog.addEventListener('close', () => { dialogContent.replaceChildren(); });

			const previewVideos = [...document.querySelectorAll<HTMLVideoElement>('.preview-video')];
			if ('IntersectionObserver' in window && previewVideos.length) {
				const playing = new Set<HTMLVideoElement>();
				const visible = new Set<HTMLVideoElement>();
				const observer = new IntersectionObserver((entries) => {
					entries.forEach(({ target, isIntersecting }) => {
						const video = target as HTMLVideoElement;
						if (isIntersecting) visible.add(video);
						else { visible.delete(video); video.pause(); playing.delete(video); }
					});
					for (const video of visible) {
						if (playing.size >= 2) break;
						if (!playing.has(video)) { playing.add(video); video.play().catch(() => playing.delete(video)); }
					}
				}, { threshold: 0.5 });
				previewVideos.forEach((video) => observer.observe(video));
			}

			document.querySelectorAll<HTMLButtonElement>('.copy-email').forEach((button) => button.addEventListener('click', async () => {
				try {
					await navigator.clipboard.writeText(button.dataset.email!);
					button.nextElementSibling!.textContent = 'Email copied';
				} catch {
					button.nextElementSibling!.textContent = 'Copy unavailable. Use the email link.';
				}
			}));
		</script>
	</body>
</html>
